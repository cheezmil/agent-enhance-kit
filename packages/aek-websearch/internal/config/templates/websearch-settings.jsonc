{
  // AEK websearch settings.
  // This file was auto-generated by: aek websearch init
  // Edit values below, then restart the aek server (aek serve / aek mcp).

  // HTTP (REST + MCP) listen port.
  "port": 1350,
  "bind_host": "127.0.0.1",
  // RRF (Reciprocal Rank Fusion): merge & dedup results from multiple providers by rank. false = raw order, no merge.
  "rrf_enabled": false,
  "providers": {
    "serper": {
      // include this provider in default (no -p flag) searches
      "default": true,
      "timeout_seconds": 60,
      "max_results": 100
    },
    "tavily": {
      "default": true,
      "timeout_seconds": 60,
      "max_results": 20
    },
    "exa": {
      "default": true,
      "timeout_seconds": 60,
      "max_results": 100,
      // search_type: auto, fast, instant, deep-lite, deep, deep-reasoning
      "search_type": "auto",
      // round_robin: cycle through keys in order (0->1->2->0->...) instead of always using first available.
      // Failover and cooldown always apply regardless of this setting.
      "round_robin": false
    },
    "you": {
      "default": false,
      "timeout_seconds": 60,
      "max_results": 100
    },
    "parallel": {
      "default": false,
      "timeout_seconds": 60,
      "max_results": 20
    },
    "linkup": {
      "default": false,
      "timeout_seconds": 60,
      "max_results": 20
    },
    "wolfram": {
      "default": false,
      "timeout_seconds": 60
    },
    "context7": {
      "default": false,
      "timeout_seconds": 60
    },
    "duckduckgo": {
      "default": false,
      "timeout_seconds": 60
    },
    "yahoo": {
      "default": false,
      "timeout_seconds": 60
    }
  }
}